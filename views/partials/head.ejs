<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%
  // Deelkaart voor WhatsApp, Facebook, LinkedIn enz. Per pagina te overschrijven
  // door ogTitel / ogTekst mee te geven aan res.render.
  const ogT = typeof ogTitel === 'undefined' ? 'Garagedeur vervangen? Drutex D-GATE op maat' : ogTitel;
  const ogB = typeof ogTekst === 'undefined'
    ? 'Sectionaaldeuren op maat, geleverd en gemonteerd. Gratis inmeting, offerte binnen 1 werkdag.'
    : ogTekst;
%>
<meta name="description" content="Garagedeur vervangen? Drutex D-GATE sectionaaldeuren op maat, geleverd en gemonteerd. FingerSafe-veiligheid, hoge isolatie (40/60 mm), montage in één dag. Vraag vrijblijvend een offerte aan.">
<link rel="canonical" href="<%= paginaUrl %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="MaatwerkGaragedeur.nl">
<meta property="og:locale" content="nl_NL">
<meta property="og:url" content="<%= paginaUrl %>">
<meta property="og:title" content="<%= ogT %>">
<meta property="og:description" content="<%= ogB %>">
<meta property="og:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v %>">
<meta property="og:image:secure_url" content="<%= siteUrl %>/img/og.jpg?v=<%= v %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="MaatwerkGaragedeur.nl — Drutex D-GATE sectionaaldeuren op maat">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= ogT %>">
<meta name="twitter:description" content="<%= ogB %>">
<meta name="twitter:image" content="<%= siteUrl %>/img/og.jpg?v=<%= v %>">
