<!DOCTYPE html>
<html lang="nl">
<head>
  <title>Offerte aanvragen — nieuwe garagedeur | MaatwerkGaragedeur.nl</title>
  <%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<section class="sectie pagina-kop">
  <div class="wrap">
    <p class="kicker">Vrijblijvend &middot; binnen 1 werkdag reactie</p>
    <h1>Offerte aanvragen</h1>
    <p class="pagina-intro">Meet de breedte en hoogte van je garageopening bij benadering op (op de centimeter nauwkeurig hoeft niet — dat doen wij bij de gratis inmeting) en vul het formulier in.</p>
  </div>
</section>

<section class="sectie">
  <div class="wrap offerte-wrap">
    <% if (verzonden) { %>
      <div class="melding melding-ok">
        <h2>Aanvraag ontvangen ✓</h2>
        <p>Bedankt! We nemen binnen 1 werkdag contact met je op met een vrijblijvende prijsopgave. Heb je een e-mailadres opgegeven, dan vind je daar een bevestiging.</p>
        <a href="/" class="btn btn-secundair">Terug naar home</a>
      </div>
    <% } else { %>
      <%
        const v = typeof waarden !== 'undefined' && waarden ? waarden : {};
        const keuze = (naam, optie) => v[naam] === optie ? ' selected' : '';
      %>
      <% if (typeof fout !== 'undefined' && fout) { %>
        <div class="melding melding-fout" role="alert">
          <p><%= fout %></p>
        </div>
      <% } %>
      <div class="offerte-layout">
      <aside class="offerte-zijkant">
        <div class="offerte-preview">
          <%- include('partials/deur-svg', { metOpties: false }) %>
          <p class="preview-hint">Indicatieve weergave van je kleur- en afwerkingkeuze. Tijdens de gratis inmeting laten we echte stalen zien.</p>
        </div>
      </aside>

      <form method="POST" action="/offerte" class="offerte-form">
        <div style="position:absolute; left:-9999px; top:-9999px;" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        </div>
        <fieldset>
          <legend>Je gegevens</legend>
          <div class="veld-rij">
            <label>Naam *<input type="text" name="naam" required autocomplete="name" value="<%= v.naam || '' %>"></label>
            <label>E-mail *<input type="email" name="email" required autocomplete="email" value="<%= v.email || '' %>"></label>
          </div>
          <div class="veld-rij">
            <label>Telefoon<input type="tel" name="telefoon" autocomplete="tel" value="<%= v.telefoon || '' %>"></label>
            <label>Postcode *<input type="text" name="postcode" required autocomplete="postal-code" placeholder="1234 AB" value="<%= v.postcode || '' %>"></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Je garageopening</legend>
          <div class="veld-rij">
            <label>Breedte (cm) *<input type="number" name="breedte" min="150" max="600" required placeholder="bijv. 250" value="<%= v.breedte || '' %>"></label>
            <label>Hoogte (cm) *<input type="number" name="hoogte" min="150" max="350" required placeholder="bijv. 212" value="<%= v.hoogte || '' %>"></label>
          </div>
        </fieldset>

        <fieldset class="kleur-veld">
          <legend>Kleur &amp; afwerking <span class="optioneel">(optioneel — je ziet het direct)</span></legend>

          <span class="optie-label">Profilering <span class="optioneel">— de groeven in het paneel; dit zie je hiernaast meteen terug</span></span>
          <div class="paneel-keuzes">
            <% profileringen.forEach((p, i) => {
                 const aan = v.profilering ? v.profilering === p.naam : i === 2; %>
              <label class="profiel-knop<%= aan ? ' actief' : '' %>" data-profiel="<%= p.profiel %>">
                <input type="radio" name="profilering" value="<%= p.naam %>"<%= aan ? ' checked' : '' %>>
                <span><%= p.naam %> <span class="afwerking-code"><%= p.code %></span></span>
              </label>
            <% }) %>
          </div>

          <span class="optie-label">Paneelafwerking <span class="optioneel">— het oppervlak van het paneel</span></span>
          <div class="afwerking-rooster">
            <% afwerkingen.forEach((a, i) => {
                 const aan = v.afwerking ? v.afwerking === a.naam : i === 1; %>
              <label class="afwerking-tegel">
                <input type="radio" name="afwerking" value="<%= a.naam %>"<%= aan ? ' checked' : '' %>>
                <img src="<%= a.afb %>" alt="Paneel <%= a.naam %>" loading="lazy" width="760" height="1040">
                <span class="afwerking-naam"><%= a.naam %></span>
                <span class="afwerking-kort"><%= a.kort %></span>
              </label>
            <% }) %>
          </div>

          <span class="optie-label">Kleur</span>
          <label class="kleur-geen">
            <input type="radio" name="kleur" value=""<%= v.kleur ? '' : ' checked' %>>
            <span>Weet ik nog niet — advies gewenst</span>
          </label>
          <% [['klassiek','Wit &amp; crème'],['grijs','Grijs &amp; zwart'],['hout','Houtdecoren'],['kleur','Kleuraccenten']].forEach(([cat, kopje]) => { %>
            <h3 class="kleur-cat"><%- kopje %></h3>
            <div class="kleur-rooster">
              <% kleuren.filter(k => k.cat === cat).forEach(k => { %>
                <label class="kleur-tegel" style="--c: <%= k.hex %>" data-hex="<%= k.hex %>" data-naam="<%= k.naam %>">
                  <input type="radio" name="kleur" value="<%= k.naam %>"<%= v.kleur === k.naam ? ' checked' : '' %>>
                  <span class="kleur-vlak"></span>
                  <span class="kleur-naam"><%= k.naam %></span>
                </label>
              <% }) %>
            </div>
          <% }) %>
        </fieldset>

        <fieldset>
          <legend>Je voorkeuren <span class="optioneel">(optioneel — wij adviseren graag)</span></legend>
          <span class="optie-label">Model <span class="optioneel">— het verschil zit in de veer, niet in het aanzicht</span></span>
          <div class="model-rooster">
            <label class="model-tegel model-tegel-geen">
              <input type="radio" name="model" value=""<%= v.model ? '' : ' checked' %>>
              <span class="model-naam">Weet ik nog niet</span>
              <span class="model-sub">Wij adviseren op basis van je latei en zijruimte</span>
            </label>
            <% modellen.forEach(mo => { const waarde = `${mo.naam} (${mo.sub.toLowerCase()})`; %>
              <label class="model-tegel" data-max-breedte="<%= mo.maxCm.breedte %>" data-max-hoogte="<%= mo.maxCm.hoogte %>">
                <input type="radio" name="model" value="<%= waarde %>"<%= v.model === waarde ? ' checked' : '' %>>
                <%- include('partials/model-beeld', { m: mo }) %>
                <span class="model-naam"><%= mo.naam %></span>
                <span class="model-sub"><%= mo.sub %></span>
                <span class="model-tekst"><%= mo.kort %></span>
                <span class="model-spec">
                  Tot <%= mo.maxCm.breedte %> &times; <%= mo.maxCm.hoogte %> cm &middot; paneel tot <%= mo.specs.gewicht %><br>
                  Latei vanaf <%= mo.specs.latei %>
                </span>
                <span class="model-tegroot" hidden>Te klein voor de maat die je invulde</span>
              </label>
            <% }) %>
          </div>

          <label>Paneeldikte
            <select name="dikte" id="dikteSelect">
              <option value="">Weet ik nog niet</option>
              <% diktes.forEach(dk => { %>
                <option value="<%= dk.naam %>"<%= keuze('dikte', dk.naam) %><% if (dk.alleenModel) { %> data-alleen-model="<%= dk.alleenModel %>"<% } %>><%= dk.naam %><% if (dk.alleenModel) { %> — alleen <%= dk.alleenModel %><% } %></option>
              <% }) %>
            </select>
          </label>
          <p class="veld-hint" id="dikteHint" hidden>60 mm is alleen leverbaar op de D-GATE U — dat model is voor je aangevinkt.</p>
          <label>Bediening
            <select name="motor">
              <option value="">Weet ik nog niet</option>
              <option<%= keuze('motor', 'Handbediend') %>>Handbediend</option>
              <option<%= keuze('motor', 'Elektrisch met handzender') %>>Elektrisch met handzender</option>
              <option<%= keuze('motor', 'Elektrisch + smart home') %>>Elektrisch + smart home</option>
            </select>
          </label>
          <label>Opmerkingen
            <textarea name="opmerking" rows="4" placeholder="Bijv. huidige deur is een kanteldeur, beperkte ruimte boven de opening, gewenste beglazing…"><%= v.opmerking || '' %></textarea>
          </label>
        </fieldset>

        <fieldset class="som-veld">
          <legend>Even controleren</legend>
          <p class="som-uitleg">Zo weten we zeker dat je geen robot bent.</p>
          <input type="hidden" name="som_token" value="<%= som.token %>">
          <label for="somAntwoord">Hoeveel is <strong class="som-vraag"><%= som.vraag %></strong>? *</label>
          <input type="number" id="somAntwoord" name="som_antwoord" required inputmode="numeric"
                 autocomplete="off" placeholder="Vul de uitkomst in">
        </fieldset>

        <button type="submit" class="btn btn-primair btn-groot">Verstuur aanvraag</button>
        <p class="form-klein">Door te versturen ga je akkoord met onze <a href="/privacy">privacyverklaring</a>. Je gegevens worden uitsluitend gebruikt om je aanvraag te behandelen.</p>
      </form>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
